# Native development example. Copy to .env and replace every CHANGE_ME value.
APP_PORT=8000
APP_HOST=127.0.0.1
APP_DATA_DIR=./data
MAX_UPLOAD_MB=50
UPLOAD_REQUEST_TIMEOUT_MS=3000000

PDF_OCR_ENABLED=true
PDF_OCR_LANGUAGES=chi_sim+eng
PDF_OCR_MAX_PAGES=500
PDF_OCR_DPI=180
PDF_OCR_TIMEOUT_MS=2700000
PDF_OCR_BATCH_PAGES=8
PDF_OCR_PAGE_CONCURRENCY=2
TESSERACT_PATH=tesseract
PDFINFO_PATH=pdfinfo
PDFTOPPM_PATH=pdftoppm
PDF_OCR_TEMP_DIR=./data/ocr-temp

SESSION_HOURS=24
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhizhi_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=zhizhi_knowledge
DB_CONNECTION_LIMIT=10
ACCEPTANCE_MODE=false

# DeepSeek OpenAI-compatible cloud API. API Key stays on the backend only.
LLM_PROVIDER=api
LLM_API_BASE_URL=https://agentrs.jd.com/api/saas/openai-u/v1
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_API_MODEL=DeepSeek-V4-Flash
LLM_API_TIMEOUT_MS=30000
LLM_API_MAX_RETRIES=1
LLM_API_MAX_TOKENS=1024

# Embedding uses a separate OpenAI-compatible cloud API.
EMBEDDING_PROVIDER=api
EMBEDDING_API_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_API_KEY
EMBEDDING_API_MODEL=CHANGE_ME_EMBEDDING_MODEL
EMBEDDING_API_TIMEOUT_MS=30000
EMBEDDING_API_MAX_RETRIES=3
EMBEDDING_API_BATCH_SIZE=16
# Required: use the exact dimension published by the embedding provider.
EMBEDDING_API_DIMENSION=
EMBEDDING_GENERATION=1

# Hybrid RAG exam-ready defaults; recalibrate after the cloud embedding is available.
RAG_RRF_K=60
RAG_RRF_CONTENT_WEIGHT=1
RAG_RRF_METADATA_WEIGHT=1.25
RAG_RRF_EXACT_WEIGHT=1.25
RAG_RRF_VECTOR_WEIGHT=1
RAG_CONTEXT_BUDGET_TOKENS=6000
