APP_PORT=8000
APP_DATA_DIR=./data
MAX_UPLOAD_MB=20
SESSION_HOURS=24
ADMIN_PASSWORD=Admin@123
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=knowledge_app
DB_PASSWORD=请修改为强密码
DB_NAME=knowledge_platform
DB_CONNECTION_LIMIT=10

# Ollama 可运行在本机，也可填写 Windows 的 Tailscale 地址
LOCAL_LLM_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_NUM_GPU=99
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=10m

# 启用 Qwen3 Embedding 后使用向量与关键词混合检索
EMBEDDING_ENABLED=false
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_TIMEOUT_MS=90000
OLLAMA_EMBEDDING_BATCH_SIZE=16
EMBEDDING_MIN_SCORE=0.35
