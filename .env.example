# Native development example. Copy to .env and replace every CHANGE_ME value.
APP_PORT=8000
APP_DATA_DIR=./data
MAX_UPLOAD_MB=50
UPLOAD_REQUEST_TIMEOUT_MS=3000000

PDF_OCR_ENABLED=true
PDF_OCR_LANGUAGES=chi_sim+eng
PDF_OCR_MAX_PAGES=500
PDF_OCR_DPI=180
PDF_OCR_TIMEOUT_MS=2700000
PDF_OCR_BATCH_PAGES=8
PDF_OCR_PAGE_CONCURRENCY=2
TESSERACT_PATH=tesseract
PDFINFO_PATH=pdfinfo
PDFTOPPM_PATH=pdftoppm
PDF_OCR_TEMP_DIR=./data/ocr-temp

SESSION_HOURS=24
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhizhi_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=zhizhi_knowledge
DB_CONNECTION_LIMIT=10

LOCAL_LLM_ENABLED=true
EMBEDDING_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_EMBEDDING_TIMEOUT_MS=90000
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_HISTORY_MESSAGES=4
OLLAMA_MAX_CONTINUATIONS=2

